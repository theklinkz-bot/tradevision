        <h4 className="text-[10px] font-black text-brand-text-dim uppercase tracking-[0.2em] ml-1">{t.ui.ai_neural_insights}</h4>
        <InsightPanel stats={stats} t={t} />
      </div>

      {/* 2. Primary Metrics Bar */}
