            <div className={`text-2xl font-bold tracking-tighter ${currentEquity >= 0 ? 'text-brand-success' : 'text-brand-danger'}`}>
              {currentEquity >= 0 ? '+' : ''}{currentEquity.toFixed(2)}R
            </div>
